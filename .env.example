# Copy to .env (repo root) and adjust. .env is git-ignored.

# Database: the local Docker Postgres from docker-compose.yml.
# Used by the server and by `npm run migrate` / `npm run migrate:down`.
# TLS comes from sslmode: disable for this local container (it has no TLS). A database
# that is not local (Neon) must say sslmode=verify-full, or the server refuses to start.
DATABASE_URL=postgres://relay:relay@localhost:5433/relay_dev?sslmode=disable

# The test database is separate. Do not point the app at it. `npm test` uses it
# automatically (and migrates it); the DATABASE_URL above is never used by tests.
# To migrate it by hand:
#   DATABASE_URL=postgres://relay:relay@localhost:5433/relay_test?sslmode=disable npm run migrate

# Server
PORT=5001
# The app's public URL, the only origin allowed to change state or open a socket:
# Vite's :5173 in development (it proxies /api and /socket.io here); the Render URL in production.
CLIENT_URL=http://localhost:5173

# Leave unset locally. NODE_ENV=production (set on Render) makes the session cookie
# __Host-relay_session with Secure, which browsers accept only over HTTPS.
# NODE_ENV=production

# How many proxies in front of the server to trust for X-Forwarded-For (the client IP
# that request logs and rate limits use). 0 locally; Render needs 1 (verified at release).
# TRUST_PROXY=0

# Optional: fatal | error | warn | info (default) | debug | trace | silent
# LOG_LEVEL=info
